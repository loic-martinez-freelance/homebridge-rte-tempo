{
  "pluginAlias": "RteTempo",
  "pluginType": "platform",
  "footerDisplay": "Plugin Homebridge pour connaitre la couleur du jour sur Tempo.",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "refreshrate": {
        "required": true,
        "type": "string",
        "title": "Actualisation",
        "description": "Fréquence d'actualisation de la valeur RTE Tempo",
        "default": "daily",
        "oneOf": [
          {
            "title": "Une fois par jours",
            "enum": ["daily"]
          },
          {
            "title": "Toutes les heures",
            "enum": ["hourly"]
          }
        ]
      },
      "forceDetectorRefresh": {
        "required": true,
        "type": "string",
        "title": "Rafraichir la valeur du detecteur",
        "description": "Déclenche un switch on/off du detecteur de la couleur du jour",
        "default": "hourly",
        "oneOf": [
          {
            "title": "Toutes les heures",
            "enum": ["hourly"]
          },
          {
            "title": "Toutes les minutes",
            "enum": ["minutes"]
          }
        ]
      }
    }
  }
}
